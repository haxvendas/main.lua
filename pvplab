-- LocalScript: Anti Fly Longe (fica no msm lugar ao levar hit) - versão discreta/natural

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid", 8)
local root = character:WaitForChild("HumanoidRootPart", 8)

if not humanoid or not root then return end

-- Configs sutis (ajuste se precisar)
local KB_REDUCTION = 0.01       -- 22% = voa ~1/5 da distância normal (bem pouco, parece hit fraco/resistência)
local ACTIVATION_THRESHOLD = 18 -- velocity horizontal >18 pra ativar (hits fracos não ativam)
local SAFETY_INTERVAL = 0.5     -- loop de segurança mais lento

-- Anti-knockback principal: só corta horizontal, deixa vertical/altura natural
RunService.Heartbeat:Connect(function()
    if humanoid.Health <= 0 then return end
    
    local vel = root.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    local horizMag = horizVel.Magnitude
    
    -- Só ativa quando tem knock forte (evita interferir em corrida/pulo normal)
    if horizMag > ACTIVATION_THRESHOLD 
    and (humanoid:GetState() == Enum.HumanoidStateType.Physics
         or humanoid:GetState() == Enum.HumanoidStateType.Ragdoll
         or humanoid.PlatformStand
         or humanoid.FloorMaterial == Enum.Material.Air) then
        
        -- Reduz horizontal drasticamente, mas mantém um restinho pra parecer natural
        -- Não toca vertical pra não parecer bug (pode cair normal)
        root.AssemblyLinearVelocity = Vector3.new(
            vel.X * KB_REDUCTION,
            vel.Y,  -- deixa altura natural
            vel.Z * KB_REDUCTION
        )
    end
end)

-- Segurança extra: se ainda tiver velocity horizontal alta no chão/ragdoll, corta mais
task.spawn(function()
    while task.wait(SAFETY_INTERVAL) do
        if humanoid.Health <= 0 then continue end
        
        local vel = root.AssemblyLinearVelocity
        local horizMag = Vector3.new(vel.X, 0, vel.Z).Magnitude
        
        if horizMag > 12  -- threshold menor aqui pra corrigir resquícios
        and root.AssemblyLinearVelocity.Magnitude < 25  -- evita cortar pulo/alto
        and (humanoid.PlatformStand 
             or humanoid:GetState() == Enum.HumanoidStateType.Ragdoll
             or humanoid:GetState() == Enum.HumanoidStateType.Physics
             or humanoid.FloorMaterial ~= Enum.Material.Air) then
            
            root.AssemblyLinearVelocity = Vector3.new(
                vel.X * 0.15,  -- corta mais forte no chão
                vel.Y,
                vel.Z * 0.15
            )
        end
    end
end)

