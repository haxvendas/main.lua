-- Procura o slot com MAIOR Earn

-- =============================================

local function acharMelhorsecretandstellarInfo()

    local char = plr.Character

    if not char or not char:FindFirstChild("HumanoidRootPart") then

        return nil

    end

    local client = workspace:FindFirstChild("Client")

    local bases = client and client:FindFirstChild("Bases")

    if not bases then return nil end

    local melhorValor = -1

    local melhorInfo = nil

    for _, base in ipairs(bases:GetChildren()) do

        local slots = base:FindFirstChild("Slots")

        if not slots then continue end

        for _, slot in ipairs(slots:GetChildren()) do

            local ui = slot:FindFirstChild("Brainrot_UI")

            local frame = ui and ui:FindFirstChild("Frame")

            if not frame then continue end

            local rarityLabel = frame:FindFirstChild("Rarity")
local titleLabel = frame:FindFirstChild("Title")

if not rarityLabel or not rarityLabel:IsA("TextLabel") then continue end
if not titleLabel or not titleLabel:IsA("TextLabel") then continue end

local txt = rarityLabel.Text:lower() -- continua filtrando pela RARITY

            local ehValido = false

            for _, termo in ipairs(TERMOS) do

                if txt:find(termo, 1, true) then -- plain find (mais rápido)

                    ehValido = true

                    break

                end

            end

            if not ehValido then continue end

            local earnLabel = frame:FindFirstChild("Earn")

            if not earnLabel or not earnLabel:IsA("TextLabel") then continue end

            -- Tenta converter o texto de forma mais robusta

            local texto = earnLabel.Text:gsub("[^%d%.]", "") -- mantém pontos (1.5k → 1.5)

            local valorNumerico = tonumber(texto)

            -- Se falhar (ex: "1.2K", "950/s"), aqui você pode adicionar parsing extra

            if not valorNumerico then

                -- Exemplo básico de suporte a "k" / "K"

                local num, letra = texto:match("([%d%.]+)([Kk]?)")

                if num then

                    valorNumerico = tonumber(num)

                    if letra:lower() == "k" then valorNumerico = valorNumerico * 1000 end

                end

            end

            if not valorNumerico or valorNumerico <= melhorValor then continue end

            -- Novo melhor encontrado

            melhorValor = valorNumerico

            local promptReal = nil

            for _, obj in ipairs(slot:GetDescendants()) do

                if obj:IsA("ProximityPrompt") then promptReal = obj break end

            end

            if not promptReal then

                for _, obj in ipairs(base:GetDescendants()) do

                    if obj:IsA("ProximityPrompt") then promptReal = obj break end

                end

            end

            melhorInfo = {

                slot = slot,

                base = base,

              title = titleLabel,
          
              texto = titleLabel.Text,

                valor = valorNumerico,

                valorTexto = earnLabel.Text,

                promptReal = promptReal,

            }

        end

    end

    return melhorInfo

end

