local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local _G = _G or {}
if _G.PromptConnection then _G.PromptConnection:Disconnect() end
_G.PromptActive = false

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoPromptMobileUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local targetParent = CoreGui or LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.Parent = targetParent

local MainButton = Instance.new("TextButton")
MainButton.Size = UDim2.new(0, 140, 0, 50)
MainButton.Position = UDim2.new(0.02, 0, 0.5, -25)
MainButton.BackgroundColor3 = Color3.fromRGB(240, 78, 78)
MainButton.Text = "Auto Prompt: OFF"
MainButton.TextColor3 = Color3.fromRGB(255, 255, 255)
MainButton.Font = Enum.Font.SourceSansBold
MainButton.TextSize = 16
MainButton.ClipsDescendants = true
MainButton.AutoButtonColor = false
MainButton.Active = true
MainButton.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainButton

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(0, 0, 0)
UIStroke.Thickness = 2
UIStroke.Transparency = 0.5
UIStroke.Parent = MainButton

local function handlePrompt(prompt)
    if not _G.PromptActive then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp and prompt:IsA("ProximityPrompt") then
        local parentPart = prompt:FindFirstAncestorWhichIsA("BasePart") or prompt.Parent
        
        if parentPart and parentPart:IsA("BasePart") then
            local distance = (hrp.Position - parentPart.Position).Magnitude
            
            if distance <= prompt.MaxActivationDistance then
                prompt:InputHoldBegin()
                prompt:InputHoldEnd()
            end
        end
    end
end

_G.PromptConnection = game.DescendantAdded:Connect(function(descendant)
    if _G.PromptActive and descendant:IsA("ProximityPrompt") then
        handlePrompt(descendant)
    end
end)

task.spawn(function()
    while true do
        if _G.PromptActive then
            for _, descendant in ipairs(game:GetDescendants()) do
                if descendant:IsA("ProximityPrompt") then
                    handlePrompt(descendant)
                end
            end
        end
        task.wait()
    end
end)

local dragging = false
local dragInput, dragStart, startPos

MainButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

MainButton.MouseButton1Click:Connect(function()
    _G.PromptActive = not _G.PromptActive
    
    local targetColor = _G.PromptActive and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(240, 78, 78)
    local targetText = _G.PromptActive and "Auto Prompt: ON" or "Auto Prompt: OFF"
    
    MainButton.Text = targetText
    TweenService:Create(MainButton, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingStyle.InOut), {BackgroundColor3 = targetColor}):Play()
end)
