-- [ CONFIGURAÇÕES ]
local InfJumpEnabled = true
local InstaPromptEnabled = true

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local savedLocation = nil
local autoSavedLocation = nil 
local isLooping = false -- Controla o estado do loop da coleta

-- [ FUNÇÃO: SALVAMENTO AUTOMÁTICO INICIAL ]
local function saveInitialLocation()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if root then
        autoSavedLocation = root.CFrame
        print("Posição inicial salva automaticamente!")
    end
end

task.spawn(saveInitialLocation)

LocalPlayer.CharacterAdded:Connect(function(char)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if root then
        autoSavedLocation = root.CFrame
    end
end)

-- [ FUNÇÃO: PARSE DE VALORES ]
-- Converte os sufixos ($500M/s, 1K, 2.5B, etc) em números reais para ordenar o rank
local function parseValueString(valueString)
    if not valueString then return -1 end
    
    local cleaned = string.gsub(valueString, "[%$%/s%s]", "")
    local multiplier = 1
    local lastChar = string.sub(cleaned, -1, -1)

    if lastChar == "K" then
        multiplier = 1000
        cleaned = string.sub(cleaned, 1, -2)
    elseif lastChar == "M" then
        multiplier = 1000000
        cleaned = string.sub(cleaned, 1, -2)
    elseif lastChar == "B" then
        multiplier = 1000000000
        cleaned = string.sub(cleaned, 1, -2)
    elseif lastChar == "T" then
        multiplier = 1000000000000
        cleaned = string.sub(cleaned, 1, -2)
    end

    return (tonumber(cleaned) or 0) * multiplier
end

-- [ FUNÇÃO: INSTA PROXIMITY PROMPT ]
local function applyInstaPrompt(obj)
    if obj:IsA("ProximityPrompt") and InstaPromptEnabled then
        obj.HoldDuration = 0
    end
end

game.DescendantAdded:Connect(applyInstaPrompt)
for _, v in ipairs(game:GetDescendants()) do applyInstaPrompt(v) end

-- [ FUNÇÃO: INFINITE JUMP ]
UserInputService.JumpRequest:Connect(function()
    if InfJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and root then
            root.Velocity = Vector3.new(root.Velocity.X, 50, root.Velocity.Z)
        end
    end
end)

-- [ FUNÇÃO: CRIAR INTERFACE (GUI) ]
local function createGUI()
    if LocalPlayer.PlayerGui:FindFirstChild("CustomTeleportGUI") then
        LocalPlayer.PlayerGui.CustomTeleportGUI:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CustomTeleportGUI"
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.ResetOnSpawn = false

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 200, 0, 150)
    Frame.Position = UDim2.new(1, -210, 0.5, -75)
    Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Frame.BorderSizePixel = 0
    Frame.Active = true
    Frame.Draggable = true
    Frame.Parent = ScreenGui

    local function createBtn(text, pos, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 180, 0, 40)
        btn.Position = pos
        btn.BackgroundColor3 = color
        btn.Text = text
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 16
        btn.Parent = Frame
        return btn
    end

    local SaveBtn = createBtn("Salvar Local", UDim2.new(0.5, -90, 0, 10), Color3.fromRGB(60, 120, 60))
    local TeleBtn = createBtn("Teleportar", UDim2.new(0.5, -90, 0, 55), Color3.fromRGB(60, 60, 120))
    local AutoBtn = createBtn("Coleta Automática", UDim2.new(0.5, -90, 0, 100), Color3.fromRGB(150, 80, 80))

    SaveBtn.MouseButton1Click:Connect(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            savedLocation = LocalPlayer.Character.HumanoidRootPart.CFrame
            print("Local salvo manualmente!")
        end
    end)

    TeleBtn.MouseButton1Click:Connect(function()
        if savedLocation and LocalPlayer.Character then
            LocalPlayer.Character.HumanoidRootPart.CFrame = savedLocation
        end
    end)

    -- LÓGICA DA COLETA AUTOMÁTICA COM SISTEMA DE RANKING
    AutoBtn.MouseButton1Click:Connect(function()
        isLooping = not isLooping 
        
        if isLooping then
            AutoBtn.BackgroundColor3 = Color3.fromRGB(80, 150, 80) -- Verde (Ativado)
            AutoBtn.Text = "Coleta: RANKING"
            
            task.spawn(function()
                while isLooping do
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        
                        if not autoSavedLocation then
                            autoSavedLocation = char.HumanoidRootPart.CFrame
                        end
                        
                        -- Tabela para armazenar o Rank de alvos
                        local animalRank = {}

                        local plots = workspace:FindFirstChild("Plots")
                        if plots then
                            local myName = LocalPlayer.Name:lower()
                            local myDisplayName = LocalPlayer.DisplayName:lower()

                            -- 1. ETAPA: Escanear e coletar TODOS os animais válidos do servidor
                            for _, plot in ipairs(plots:GetChildren()) do
                                local plotSign = plot:FindFirstChild("PlotSign")
                                local surfaceGui = plotSign and plotSign:FindFirstChild("SurfaceGui")
                                local frameGui = surfaceGui and surfaceGui:FindFirstChild("Frame")
                                local textLabel = frameGui and frameGui:FindFirstChildOfClass("TextLabel")
                                
                                local isMyPlot = false
                                
                                if textLabel then
                                    local signText = textLabel.Text:lower()
                                    local ownerName = string.gsub(signText, "'s base", "")
                                    ownerName = string.gsub(ownerName, "%s", "")

                                    if ownerName == myName or ownerName == myDisplayName or string.find(signText, myName) or string.find(signText, myDisplayName) then
                                        isMyPlot = true
                                    end
                                end

                                -- Adiciona os animais ao Rank se não for o seu lote
                                if not isMyPlot then
                                    local podiums = plot:FindFirstChild("AnimalPodiums")
                                    if podiums then
                                        for _, podium in ipairs(podiums:GetChildren()) do
                                            local gen = podium:FindFirstChild("Generation", true)
                                            if gen and gen:IsA("TextLabel") then
                                                local currentVal = parseValueString(gen.Text)
                                                local prompt = podium:FindFirstChildOfClass("ProximityPrompt") or podium:FindFirstChild("ProximityPrompt", true)
                                                
                                                local base = podium:FindFirstChild("Base")
                                                local pos = base and base:GetPivot() or podium:GetPivot()
                                                
                                                -- Só guarda se tiver uma posição e um prompt ativo
                                                if pos and prompt and currentVal > 0 then
                                                    table.insert(animalRank, {
                                                        value = currentVal,
                                                        position = pos,
                                                        prompt = prompt
                                                    })
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        -- 2. ETAPA: Ordenar o ranking do maior valor para o menor (Melhor pro Pior)
                        table.sort(animalRank, function(a, b)
                            return a.value > b.value
                        end)

                        -- 3. ETAPA: Teleportar e coletar seguindo a ordem do Rank
                        if #animalRank > 0 then
                            print("--- INICIANDO ROTA DE COLETA (", #animalRank, "Alvos Encontrados ) ---")
                            
                            for index, animal in ipairs(animalRank) do
                                -- Se você desligar o botão no meio do caminho, ele interrompe o percurso imediatamente
                                if not isLooping then break end
                                
                                print("Rank #" .. index .. " | Valor: " .. animal.value)
                                
                                -- Teleporte até o animal
                                char.HumanoidRootPart.CFrame = animal.position * CFrame.new(0, 6, 0)
                                task.wait(0.35) -- Tempo para processar o teleporte
                                
                                -- Executa o click no Prompt
                                if fireproximityprompt then
                                    fireproximityprompt(animal.prompt)
                                else
                                    animal.prompt:InputHoldBegin()
                                    task.wait(0.15)
                                    animal.prompt:InputHoldEnd()
                                end
                                
                                task.wait(0.2) -- Pausa rápida pós-coleta
                            end
                            
                            -- 4. ETAPA: Voltar para a base inicial após completar o Rank atual
                            if isLooping then
                                char.HumanoidRootPart.CFrame = autoSavedLocation
                                print("Rota completa! Retornando para descanso.")
                            end
                        else
                            warn("Nenhum animal detectado para gerar o ranking.")
                        end
                    end
                    
                    -- Tempo de espera para respirar antes de escanear o servidor e criar um novo Rank
                    task.wait(2) 
                end
            end)
        else
            -- Se clicar de novo, desativa o loop
            isLooping = false
            AutoBtn.BackgroundColor3 = Color3.fromRGB(150, 80, 80) -- Vermelho (Desativado)
            AutoBtn.Text = "Coleta Automática"
        end
    end)
end

-- Iniciar
createGUI()
LocalPlayer.CharacterAdded:Connect(createGUI)

