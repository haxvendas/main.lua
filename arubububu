-- [ CONFIGURAÇÕES ]
local InfJumpEnabled = true
local InstaPromptEnabled = true

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local savedLocation = nil
local autoSavedLocation = nil 

-- [ FUNÇÃO: PARSE DE VALORES ]
local function parseValueString(valueString)
    if not valueString then return -1 end
    local cleaned = string.gsub(valueString, "[%$%/s%s]", "")
    local multiplier = 1
    local lastChar = string.sub(cleaned, -1, -1)

    if lastChar == "K" then multiplier = 1000; cleaned = string.sub(cleaned, 1, -2)
    elseif lastChar == "M" then multiplier = 1000000; cleaned = string.sub(cleaned, 1, -2)
    elseif lastChar == "B" then multiplier = 1000000000; cleaned = string.sub(cleaned, 1, -2)
    elseif lastChar == "T" then multiplier = 1000000000000; cleaned = string.sub(cleaned, 1, -2) end

    return (tonumber(cleaned) or 0) * multiplier
end

-- [ FUNÇÃO: INSTA PROXIMITY PROMPT ]
local function applyInstaPrompt(obj)
    if obj:IsA("ProximityPrompt") and InstaPromptEnabled then
        obj.HoldDuration = 0
    end
end

game.DescendantAdded:Connect(applyInstaPrompt)
for _, v in ipairs(game:GetDescendants()) do applyInstaPrompt(v) end

-- [ FUNÇÃO: INFINITE JUMP ]
UserInputService.JumpRequest:Connect(function()
    if InfJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and root then
            root.Velocity = Vector3.new(root.Velocity.X, 50, root.Velocity.Z)
        end
    end
end)

-- [ FUNÇÃO: CRIAR INTERFACE (GUI) ]
local function createGUI()
    if LocalPlayer.PlayerGui:FindFirstChild("CustomTeleportGUI") then
        LocalPlayer.PlayerGui.CustomTeleportGUI:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CustomTeleportGUI"
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.ResetOnSpawn = false

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 200, 0, 150)
    Frame.Position = UDim2.new(1, -210, 0.5, -75)
    Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Frame.BorderSizePixel = 0
    Frame.Active = true
    Frame.Draggable = true
    Frame.Parent = ScreenGui

    local function createBtn(text, pos, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 180, 0, 40)
        btn.Position = pos
        btn.BackgroundColor3 = color
        btn.Text = text
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 16
        btn.Parent = Frame
        return btn
    end

    local SaveBtn = createBtn("Salvar Local", UDim2.new(0.5, -90, 0, 10), Color3.fromRGB(60, 120, 60))
    local TeleBtn = createBtn("Teleportar", UDim2.new(0.5, -90, 0, 55), Color3.fromRGB(60, 60, 120))
    local AutoBtn = createBtn("Coleta Automática", UDim2.new(0.5, -90, 0, 100), Color3.fromRGB(120, 60, 60))

    SaveBtn.MouseButton1Click:Connect(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            savedLocation = LocalPlayer.Character.HumanoidRootPart.CFrame
            print("Local salvo!")
        end
    end)

    TeleBtn.MouseButton1Click:Connect(function()
        if savedLocation and LocalPlayer.Character then
            LocalPlayer.Character.HumanoidRootPart.CFrame = savedLocation
        end
    end)

    -- LÓGICA DA COLETA AUTOMÁTICA (COM FILTRO DE BASE)
    AutoBtn.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        autoSavedLocation = char.HumanoidRootPart.CFrame
        
        local bestPos = nil
        local bestVal = -1
        local bestPrompt = nil

        local plots = workspace:FindFirstChild("Plots")
        if not plots then return end

        for _, plot in ipairs(plots:GetChildren()) do
            -- VERIFICAÇÃO: Só processa a base se ela tiver o PlotSign.Model (Bases de outros)
            local plotSign = plot:FindFirstChild("PlotSign")
            local hasModel = plotSign and plotSign:FindFirstChild("Model")

            if hasModel then
                local podiums = plot:FindFirstChild("AnimalPodiums")
                if podiums then
                    for _, podium in ipairs(podiums:GetChildren()) do
                        local gen = podium:FindFirstChild("Generation", true)
                        if gen and gen:IsA("TextLabel") then
                            local currentVal = parseValueString(gen.Text)
                            if currentVal > bestVal then
                                bestVal = currentVal
                                bestPrompt = podium:FindFirstChildOfClass("ProximityPrompt") or podium:FindFirstChild("ProximityPrompt", true)
                                
                                local base = podium:FindFirstChild("Base")
                                bestPos = base and base:GetPivot() or podium:GetPivot()
                            end
                        end
                    end
                end
            else
                -- Se cair aqui, é porque é a sua base ou uma base sem o modelo alvo
                print("Ignorando base: " .. plot.Name)
            end
        end

        if bestPos and bestPrompt then
            print("Teleportando para animal de valor:", bestVal)
            char.HumanoidRootPart.CFrame = bestPos * CFrame.new(0, 6, 0)
            task.wait(0.4)
            
            if fireproximityprompt then
                fireproximityprompt(bestPrompt)
            else
                bestPrompt:InputHoldBegin()
                task.wait(0.2)
                bestPrompt:InputHoldEnd()
            end
            
            task.wait(0.5)
            char.HumanoidRootPart.CFrame = autoSavedLocation
        else
            warn("Nenhum animal válido encontrado em bases de terceiros.")
        end
    end)
end

createGUI()
LocalPlayer.CharacterAdded:Connect(createGUI);
