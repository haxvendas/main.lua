local amOn=false; local amThread=nil; local amSlots={}
local function getMyBase()
    local bases=workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Bases")
    if not bases then return nil,nil end
    for i=1,12 do local b=bases:FindFirstChild("Base"..i); if b then
        local o=b:FindFirstChild("OwnerId")
        if o and tonumber(o.Value)==lp.UserId then return b,i end
    end end; return nil,nil
end
local function amStart()
    local myBase,myIdx=getMyBase(); if not myBase then return end
    local ss=myBase:FindFirstChild("Slots"); if not ss then return end
    local cb=workspace:FindFirstChild("Client") and workspace.Client:FindFirstChild("Bases")
        and workspace.Client.Bases:FindFirstChild("Base"..myIdx)
    local cs=cb and cb:FindFirstChild("Slots"); amSlots={}
    for _,slot in pairs(ss:GetChildren()) do
        local has=true
        if cs then local c2=cs:FindFirstChild(slot.Name); has=c2 and #c2:GetChildren()>0 end
        if has then local col=slot:FindFirstChild("Collect"); if not col then continue end
            local part=col:IsA("BasePart") and col or col:FindFirstChildWhichIsA("BasePart")
            if part then table.insert(amSlots,{part=part,cf=part.CFrame,an=part.Anchored,tr=part.Transparency}) end end
    end
    amThread=task.spawn(function()
        while amOn do
            local char=lp.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then task.wait(0.2); continue end
            for _,d in pairs(amSlots) do
                if not amOn then break end; if not d.part or not d.part.Parent then continue end
                for _,snd in pairs(d.part:GetDescendants()) do
                    if snd:IsA("Sound") then pcall(function() snd.Volume=0 end) end
                end
                d.part.Anchored=false; d.part.Transparency=1; d.part.CFrame=hrp.CFrame
                local pp=d.part:FindFirstChildOfClass("ProximityPrompt")
                if pp then pp.HoldDuration=0; pcall(fireproximityprompt,pp) end
                local cd=d.part:FindFirstChildOfClass("ClickDetector")
                if cd then pcall(fireclickdetector,cd) end
                task.wait(0.04); d.part.CFrame=d.cf; d.part.Anchored=d.an; d.part.Transparency=d.tr; task.wait(0.08)
            end; task.wait(0.15)
        end
    end)
end
local function amStop()
    amOn=false; if amThread then pcall(task.cancel,amThread); amThread=nil end
    for _,d in pairs(amSlots) do pcall(function()
        if d.part and d.part.Parent then d.part.CFrame=d.cf; d.part.Anchored=d.an; d.part.Transparency=d.tr end
    end) end; amSlots={}
end
