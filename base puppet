local function getBrainrotsFolder()
    local c=workspace:FindFirstChild("Client"); if not c then return nil end
    local p=c:FindFirstChild("Path"); if not p then return nil end; return p:FindFirstChild("Brainrots")
end
local function extractData(u)
    local ui=u:FindFirstChild("Brainrot_UI"); if not ui then return nil end
    local fr=ui:FindFirstChild("Frame")
    if not fr then for _,ch in pairs(ui:GetChildren()) do if ch:IsA("Frame") then fr=ch;break end end end
    if not fr then return nil end
    local nm,rar="",""
    local tl=fr:FindFirstChild("Title")
    if tl then
        local ct=tl:FindFirstChild("ContentText")
        if ct and ct.Text~="" then nm=ct.Text
        elseif tl:IsA("TextLabel") and tl.Text~="" then nm=tl.Text end
    end
    local rlObj=fr:FindFirstChild("Rarity") or fr:FindFirstChild("Ops")
    if rlObj then
        local ct=rlObj:FindFirstChild("ContentText")
        if ct and ct.Text~="" then rar=ct.Text
        elseif rlObj:IsA("TextLabel") and rlObj.Text~="" then rar=rlObj.Text end
    end
    if rar=="" then
        for _,ch in pairs(fr:GetDescendants()) do
            if ch:IsA("TextLabel") and ch.Text~="" then
                for _,kw in ipairs({"Mythic","Secret","Stellar","Luck Block"}) do
                    if string.find(ch.Text,kw,1,true) then rar=ch.Text;break end end end
            if rar~="" then break end
        end
    end
    if nm=="" then return nil end
    return {obj=u, name=nm, rarity=rar}
end
