-- ANTILAG (FIX) — SISTEMA COMPLETO COM BACKUP/RESTORE
-- ============================================================
local antiLagOn    = false
local antiLagConns = {}
local Lighting     = game:GetService("Lighting")

-- Backup de tudo que vamos modificar para restaurar depois
local alBackup = {
    parts    = {},  -- {obj, material, castShadow}
    effects  = {},  -- {obj, enabled}
    decals   = {},  -- {obj, transparency}
    meshes   = {},  -- {obj, textureId}
    surfaces = {},  -- {obj} (SurfaceAppearance destruída — não restaurável)
    lighting = {},  -- {prop, value}
    lightFx  = {},  -- {obj, enabled}
}

local function backupLighting()
    local props = {"GlobalShadows","FogEnd","FogStart","FogColor","Brightness","Ambient","OutdoorAmbient","ClockTime","GeographicLatitude","ShadowSoftness"}
    for _,p in ipairs(props) do
        pcall(function()
            table.insert(alBackup.lighting, {prop=p, val=Lighting[p]})
        end)
    end
    for _,obj in ipairs(Lighting:GetChildren()) do
        pcall(function()
            if obj:IsA("ColorCorrection") or obj:IsA("BlurEffect")
            or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect")
            or obj:IsA("BloomEffect") then
                table.insert(alBackup.lightFx, {obj=obj, enabled=obj.Enabled})
                obj.Enabled = false
            end
        end)
    end
end

local function restoreLighting()
    for _,d in ipairs(alBackup.lighting) do
        pcall(function() Lighting[d.prop] = d.val end)
    end
    for _,d in ipairs(alBackup.lightFx) do
        pcall(function() if d.obj and d.obj.Parent then d.obj.Enabled=d.enabled end end)
    end
    alBackup.lighting = {}
    alBackup.lightFx  = {}
end

-- Processa um objeto e guarda backup para restaurar
local function processObj(obj)
    if not antiLagOn then return end
    pcall(function()
        -- Animações: para e desabilita tracks
        if obj:IsA("Animator") then
            for _,t in pairs(obj:GetPlayingAnimationTracks()) do
                pcall(function() t:Stop(0) end)
            end
            return
        end

        -- Efeitos visuais (partículas, fogo, fumaça, etc.)
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
        or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
        or obj:IsA("SelectionBox") or obj:IsA("SelectionSphere") then
            table.insert(alBackup.effects, {obj=obj, enabled=obj.Enabled})
            obj.Enabled = false
            return
        end

        -- SpecialMesh: remove textura mas salva original
        if obj:IsA("SpecialMesh") then
            table.insert(alBackup.meshes, {obj=obj, textureId=obj.TextureId})
            obj.TextureId = ""
            return
        end

        -- Decal / Texture: invisível mas salva transparency original
        if obj:IsA("Decal") or obj:IsA("Texture") then
            table.insert(alBackup.decals, {obj=obj, transparency=obj.Transparency})
            obj.Transparency = 1
            return
        end

        -- SurfaceAppearance (PBR pesado): salva referência e destrói
        if obj:IsA("SurfaceAppearance") then
            -- Não tem como restaurar SurfaceAppearance de forma eficiente,
            -- então só desabilita via reparent para nil e guarda parent
            -- Solução: clone antes de destruir
            local parentObj = obj.Parent
            if parentObj then
                local clone = obj:Clone()
                table.insert(alBackup.surfaces, {clone=clone, parent=parentObj})
                obj:Destroy()
            end
            return
        end

        -- BasePart: troca material e salva original
        if obj:IsA("BasePart") then
            -- Ignora partes do personagem do jogador
            local char = lp.Character
            if char and obj:IsDescendantOf(char) then return end
            -- Ignora a própria GUI
            if obj:IsDescendantOf(ScreenGui) then return end

            local origMat   = obj.Material
            local origShadow = obj.CastShadow

            -- Só faz backup se ainda não foi processado
            table.insert(alBackup.parts, {obj=obj, material=origMat, castShadow=origShadow})

            -- Aplica: SmoothPlastic, sem sombra (preserva cor/tamanho)
            obj.Material   = Enum.Material.SmoothPlastic
            obj.CastShadow = false

            -- Limpa filhos pesados da part também
            for _,ch in ipairs(obj:GetChildren()) do
                if ch:IsA("SpecialMesh") then
                    table.insert(alBackup.meshes, {obj=ch, textureId=ch.TextureId})
                    ch.TextureId=""
                elseif ch:IsA("Decal") or ch:IsA("Texture") then
                    table.insert(alBackup.decals, {obj=ch, transparency=ch.Transparency})
                    ch.Transparency=1
                elseif ch:IsA("SurfaceAppearance") then
                    local clone=ch:Clone()
                    table.insert(alBackup.surfaces, {clone=clone, parent=obj})
                    ch:Destroy()
                elseif ch:IsA("ParticleEmitter") or ch:IsA("Trail") or ch:IsA("Beam")
                or ch:IsA("Fire") or ch:IsA("Smoke") or ch:IsA("Sparkles") then
                    table.insert(alBackup.effects, {obj=ch, enabled=ch.Enabled})
                    ch.Enabled=false
                end
            end
            return
        end

        -- Sons: muta
        if obj:IsA("Sound") then
            -- Não mexe — sons não afetam FPS relevantemente
            return
        end
    end)
end

-- Varre TODO o workspace
local function sweepWorkspace()
    for _,obj in ipairs(workspace:GetDescendants()) do
        task.defer(function() processObj(obj) end)
    end
end

-- Restaura TUDO ao estado original
local function restoreAll()
    -- Restaura BaseParts
    for _,d in ipairs(alBackup.parts) do
        pcall(function()
            if d.obj and d.obj.Parent then
                d.obj.Material   = d.material
                d.obj.CastShadow = d.castShadow
            end
        end)
    end
    -- Restaura efeitos (partículas, fire, etc.)
    for _,d in ipairs(alBackup.effects) do
        pcall(function()
            if d.obj and d.obj.Parent then
                d.obj.Enabled = d.enabled
            end
        end)
    end
    -- Restaura Decals/Textures
    for _,d in ipairs(alBackup.decals) do
        pcall(function()
            if d.obj and d.obj.Parent then
                d.obj.Transparency = d.transparency
            end
        end)
    end
    -- Restaura SpecialMesh textures
    for _,d in ipairs(alBackup.meshes) do
        pcall(function()
            if d.obj and d.obj.Parent then
                d.obj.TextureId = d.textureId
            end
        end)
    end
    -- Restaura SurfaceAppearances (reclona)
    for _,d in ipairs(alBackup.surfaces) do
        pcall(function()
            if d.parent and d.parent.Parent then
                d.clone:Clone().Parent = d.parent
            end
        end)
    end
    -- Restaura Lighting
    restoreLighting()
    -- Limpa backup
    alBackup = {parts={},effects={},decals={},meshes={},surfaces={},lighting={},lightFx={}}
end

local function antiLagEnable()
    -- Limpa backup anterior por garantia
    alBackup = {parts={},effects={},decals={},meshes={},surfaces={},lighting={},lightFx={}}
    -- Qualidade gráfica mínima
    pcall(function() settings().Rendering.QualityLevel=1 end)
    -- Backup + aplicar Lighting
    backupLighting()
    pcall(function()
        Lighting.GlobalShadows  = false
        Lighting.FogEnd         = 9e8
        Lighting.Brightness     = 1
        Lighting.Ambient        = Color3.fromRGB(130,130,130)
        Lighting.OutdoorAmbient = Color3.fromRGB(100,100,100)
    end)
    -- Varre workspace (assíncrono com task.defer para não travar)
    sweepWorkspace()
    -- Monitor em tempo real
    table.insert(antiLagConns, workspace.DescendantAdded:Connect(function(obj)
        task.defer(function() processObj(obj) end)
    end))
    table.insert(antiLagConns, Lighting.DescendantAdded:Connect(function(obj)
        task.defer(function()
            pcall(function()
                if obj:IsA("ColorCorrection") or obj:IsA("BlurEffect")
                or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect")
                or obj:IsA("BloomEffect") then
                    table.insert(alBackup.lightFx, {obj=obj, enabled=obj.Enabled})
                    obj.Enabled=false
                end
            end)
        end)
    end))
end

local function antiLagDisable()
    -- Desconecta monitores
    for _,c in ipairs(antiLagConns) do pcall(function() c:Disconnect() end) end
    antiLagConns = {}
    -- Qualidade gráfica de volta ao auto
    pcall(function() settings().Rendering.QualityLevel=Enum.QualityLevel.Automatic end)
    -- Restaura tudo
    restoreAll()
end

