local function buildSellList()
    for _,r in pairs(slotRows) do if r and r.Parent then r:Destroy() end end; slotRows={}
    local myBase,myIdx=getMyBase(); if not myBase then return end
    local ss=myBase:FindFirstChild("Slots"); if not ss then return end
    local clientBase=workspace:FindFirstChild("Client") and workspace.Client:FindFirstChild("Bases")
        and workspace.Client.Bases:FindFirstChild("Base"..myIdx)
    local cs=clientBase and clientBase:FindFirstChild("Slots")
    local order=0
    for _,slot in pairs(ss:GetChildren()) do
        local clientSlot=cs and cs:FindFirstChild(slot.Name)
        local has=clientSlot and #clientSlot:GetChildren()>0
        if not has then continue end
        order=order+1
        local displayName=getSlotName(slot, clientSlot)
        local slotBasePart=slot:FindFirstChildWhichIsA("BasePart",true)
            or (clientSlot and clientSlot:FindFirstChildWhichIsA("BasePart",true))
