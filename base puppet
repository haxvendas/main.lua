local function getSlotName(serverSlot, clientSlot)
    local function tryRead(slotObj)
        if not slotObj then return nil end
        local ui=slotObj:FindFirstChild("Brainrot_UI")
        if not ui then
            for _,ch in pairs(slotObj:GetChildren()) do local r=tryRead(ch); if r then return r end end
            return nil
        end
        local fr=ui:FindFirstChild("Frame")
        if not fr then for _,ch in pairs(ui:GetChildren()) do if ch:IsA("Frame") then fr=ch;break end end end
        if not fr then return nil end
        local tl=fr:FindFirstChild("Title")
        if tl then
            local ct=tl:FindFirstChild("ContentText")
            if ct and ct.Text~="" then return ct.Text end
            if tl:IsA("TextLabel") and tl.Text~="" then return tl.Text end
        end
        return nil
    end
    return tryRead(clientSlot) or tryRead(serverSlot) or serverSlot.Name
end

