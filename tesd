        else
            root.CFrame = (alternarParaInicial and posicaoInicial or posicaoSecundaria) * CFrame.new(0, 4, 0)
            alternarParaInicial = not alternarParaInicial
            task.wait(0.1)
            simularCliqueE()
        end
    elseif input.KeyCode == Enum.KeyCode.F then
        if flying then 
            flying = false
            if flyConnection then flyConnection:Disconnect() flyConnection = nil end
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            humanoid.PlatformStand = false
            notify("FLY", "Desativado", Color3.fromRGB(255, 80, 80))
        else 
            startVFly() 
            notify("FLY", "Ativado", Color3.fromRGB(0, 255, 120))
        end
    end
end)

