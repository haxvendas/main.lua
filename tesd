local pegando = false

local function tentarPegarItem(desc)
    if pegando then return end
    if not desc:FindFirstAncestor("ActiveBrainrots") then return end

    for _, nome in ipairs(itensProcurar) do
        if string.find(desc.Name, nome) then
            pegando = true

            task.spawn(function()
                local endPart = workspace:FindFirstChild("EndPart")
                if not endPart then
                    warn("EndPart não encontrado")
                    pegando = false
                    return
                end

                local targetCFrame
                if desc:IsA("Model") then
                    targetCFrame = desc:GetPivot()
                elseif desc:IsA("BasePart") then
                    targetCFrame = desc.CFrame
                else
                    pegando = false
                    return
                end

                -- TELEPORTA
                root.CFrame = targetCFrame * CFrame.new(0,3,0)
                print("🚀 Indo:", desc.Name)

                task.wait(0.2)

                local prompt = desc:FindFirstChildWhichIsA("ProximityPrompt", true)

                if prompt then
                    prompt.HoldDuration = 0
                    for i = 1,5 do
                        fireproximityprompt(prompt)
                        task.wait(0.2)
                    end
                    print("✅ Pegou:", desc.Name)
                else
                    warn("Sem prompt:", desc.Name)
                end

                task.wait(0.2)

                -- VOLTA
                root.CFrame = endPart.CFrame * CFrame.new(0,3,0)
                print("🔙 Voltou")

                pegando = false
            end)

            return
        end
    end
end

