local function tentarPegarItem(desc)
    if not desc:FindFirstAncestor("ActiveBrainrots") then return false end

    for _, nome in ipairs(itensProcurar) do
        if desc.Name:find(nome) then
            local targetCFrame = desc:GetPivot() or CFrame.new(desc.Position)
            root.CFrame = targetCFrame * CFrame.new(0, 15, 0)

            print("🚀 Teleportado ACIMA de: " .. desc.Name)

            task.wait(0.18)
            local prompt = desc:FindFirstChildWhichIsA("ProximityPrompt") or desc.Parent:FindFirstChildWhichIsA("ProximityPrompt")
            if prompt then
                prompt.HoldDuration = 0
                prompt:InputHoldBegin()
                task.wait(0.1)
                prompt:InputHoldEnd()
                print("👆 Pegou: " .. desc.Name)
            end
            return true
        end
    end
    return false
end

