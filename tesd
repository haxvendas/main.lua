local function cleanText(text)
    if not text then return "N/A" end
    text = text:gsub("<font color=\".-\">", "")
    text = text:gsub("</font>", "")
    return text
end

local function updateStatusGUI()
    pcall(function()
        local board = workspace:FindFirstChild("Warning")
        if not board then return end
        local painel = board:FindFirstChild("Board") and board.Board:FindFirstChild("Painel")
        if not painel then return end
        local frontGui = painel:FindFirstChild("FrontSurfaceGui")
        if not frontGui then return end
        local frameGui = frontGui:FindFirstChild("Frame")
        if not frameGui then return end

        local secret = frameGui:FindFirstChild("SecretText")
        local og = frameGui:FindFirstChild("OGText")

        if secret and secret:IsA("TextLabel") then
            secretLabel.Text = "" .. cleanText(secret.Text)
        end
        if og and og:IsA("TextLabel") then
            ogLabel.Text = "" .. cleanText(og.Text)
        end
    end)
end

