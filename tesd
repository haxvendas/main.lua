-- ====================== INPUTS ======================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.Q then
        if not posicaoSecundaria then
            posicaoSecundaria = root.CFrame
            root.CFrame = posicaoSecundaria * CFrame.new(0, 4, 0)
            print("📍 Posição Secundária salva!")
            alternarParaInicial = true
        else
            if alternarParaInicial then
                root.CFrame = posicaoInicial * CFrame.new(0, 4, 0)
                print("🚀 Teleportado para Posição Inicial")
            else
                root.CFrame = posicaoSecundaria * CFrame.new(0, 4, 0)
                print("🚀 Teleportado para Posição Secundária")
            end
            alternarParaInicial = not alternarParaInicial
        end

    elseif input.KeyCode == Enum.KeyCode.T then
        serverHop()

    elseif input.KeyCode == Enum.KeyCode.F then
        if flying then
            stopVFly()
        else
            startVFly()
        end
    end
end)

