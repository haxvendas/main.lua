local function parseEarnValue(text) 
    if not text then
        return 0
    end
    local clean = text:gsub("[%$%/s%, ]", "") 
    local suffix = clean:sub(-1):upper() 
    local number = tonumber(clean:sub(1, -2)) or tonumber(clean) 
    if not number then
        return 0
    end
    if suffix == "K" then
        return number * 1000 
    elseif suffix == "M" then
        return number * 1000000 
    elseif suffix == "B" then
        return number * 1000000000 
    elseif suffix == "T" then
        return number * 1000000000000
    end
    return tonumber(clean) or 0
end

local function formatValue(val) 
    if val >= 1e12 then
        return string.format("%.1fT", val/1e12) 
    elseif val >= 1e9 then
        return string.format("%.1fB", val/1e9) 
    elseif val >= 1e6 then
        return string.format("%.1fM", val/1e6) 
    elseif val >= 1e3 then
        return string.format("%.1fK", val/1e3)
    end
    return tostring(val)
end

