-- Main Heartbeat (Speed, Fly, Noclip)
RunService.Heartbeat:Connect(function()
    local char = Player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = isSpeedEnabled() and customSpeedVal or 32
    end

    if isFlyActive and bg and bv then
        local cam = workspace.CurrentCamera
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local md = hum.MoveDirection
                if md.Magnitude > 0 then
                    local cd = cam.CFrame.LookVector
                    local cr = cam.CFrame.RightVector
                    local fl = Vector3.new(cd.X, 0, cd.Z)
                    if fl.Magnitude > 0.001 then fl = fl.Unit
                    else fl = Vector3.new(cam.CFrame.UpVector.X, 0, cam.CFrame.UpVector.Z).Unit * -math.sign(cd.Y) end
                    local fr = Vector3.new(cr.X, 0, cr.Z)
                    if fr.Magnitude > 0.001 then fr = fr.Unit else fr = Vector3.new(1,0,0) end
                    bv.Velocity = (cd * md:Dot(fl) + cr * md:Dot(fr)) * flySpeed
                else
                    bv.Velocity = Vector3.zero
                end
                bg.CFrame = cam.CFrame
            end
        end
    end

    if noclipEnabled then
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end
end)

