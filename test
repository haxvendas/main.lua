local function createOption(name, startActive, tab, callback) 
    createOptionState(name, startActive) 
    local currentActive = optionStates[name] 
    local Container = Instance.new("Frame") 
    Container.Size = UDim2.new(0.95, 0, 0, 50) 
    Container.BackgroundColor3 = Theme.Card
    Container.Visible = (tab == activeTab) 
    Container.Parent = MainContent 
    Container.Name = name 
    Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 10) 
    local ContainerStroke = Instance.new("UIStroke") 
    ContainerStroke.Color = currentActive and Theme.Accent or Theme.StrokeDim
    ContainerStroke.Thickness = 2 
    ContainerStroke.Transparency = currentActive and 0.3 or 0.5
    ContainerStroke.Parent = Container 
    local Label = Instance.new("TextLabel") 
    Label.Size = UDim2.new(0.6, 0, 1, 0) 
    Label.Position = UDim2.new(0.05, 0, 0, 0) 
    Label.Text = name 
    Label.TextColor3 = Theme.Text
    Label.BackgroundTransparency = 1 
    Label.TextXAlignment = Enum.TextXAlignment.Left 
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 16 
    Label.Parent = Container 
    local SwitchBG = Instance.new("TextButton") 
    SwitchBG.Size = UDim2.new(0, 45, 0, 24) 
    SwitchBG.Position = UDim2.new(1, -55, 0.5, -12) 
    SwitchBG.BackgroundColor3 = currentActive and Theme.On or Theme.Off
    SwitchBG.Text = "" 
    SwitchBG.Parent = Container 
    SwitchBG.AutoButtonColor = false 
    Instance.new("UICorner", SwitchBG).CornerRadius = UDim.new(1, 0) 
    local Circle = Instance.new("Frame") 
    Circle.Size = UDim2.new(0, 18, 0, 18) 
    Circle.Position = currentActive and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9) 
    Circle.BackgroundColor3 = Theme.Circle
    Circle.Parent = SwitchBG 
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0) 
    local function toggleSwitch() 
        if createDebounce(name, 0.05) then
            optionStates[name] = not optionStates[name] 
            setOptionState(name, optionStates[name]) 
            TweenService:Create(Circle, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Position = optionStates[name] and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
            }):Play()
            TweenService:Create(SwitchBG, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                BackgroundColor3 = optionStates[name] and Theme.On or Theme.Off
            }):Play()
            TweenService:Create(ContainerStroke, TweenInfo.new(0.2), {
                Color = optionStates[name] and Theme.Accent or Theme.StrokeDim,
                Transparency = optionStates[name] and 0.3 or 0.5
            }):Play()
            if callback then
                task.wait(0.05) 
                task.spawn(function() callback(optionStates[name]) end)
            end
        end
    end
    SwitchBG.Activated:Connect(toggleSwitch) 
    SwitchBG.MouseButton1Click:Connect(toggleSwitch) 
    if currentActive and callback then
        task.spawn(function() callback(currentActive) end)
    end
    table.insert(options[tab], Container) 
    return function() return optionStates[name] end, Container, SwitchBG
end

local function createSlider(name, min, max, default, tab, callback) 
    createOptionState(name, default) 
    local currentVal = optionStates[name] 
    local Container = Instance.new("Frame") 
    Container.Size = UDim2.new(0.95, 0, 0, 60) 
    Container.BackgroundColor3 = Theme.Card
    Container.Visible = (tab == activeTab) 
    Container.Parent = MainContent 
    Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 10) 
    local SliderStroke = Instance.new("UIStroke") 
    SliderStroke.Color = Theme.StrokeDim
    SliderStroke.Thickness = 2 
    SliderStroke.Transparency = 0.5
    SliderStroke.Parent = Container 
    local Label = Instance.new("TextLabel") 
    Label.Size = UDim2.new(0.9, 0, 0.4, 0) 
    Label.Position = UDim2.new(0.05, 0, 0, 5) 
    Label.Text = name .. ": " .. tostring(currentVal) 
    Label.TextColor3 = Theme.Text
    Label.BackgroundTransparency = 1 
    Label.TextXAlignment = Enum.TextXAlignment.Left 
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 16 
    Label.Parent = Container 
    local SliderBG = Instance.new("TextButton") 
    SliderBG.Size = UDim2.new(0.9, 0, 0, 6) 
    SliderBG.Position = UDim2.new(0.05, 0, 0.65, 0) 
    SliderBG.BackgroundColor3 = Theme.Off
    SliderBG.Text = "" 
    SliderBG.Parent = Container 
    SliderBG.AutoButtonColor = false 
    Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(1, 0) 
    local SliderFill = Instance.new("Frame") 
    local startScale = (currentVal - min) / (max - min) 
    SliderFill.Size = UDim2.new(startScale, 0, 1, 0) 
    SliderFill.BackgroundColor3 = Theme.Accent
    SliderFill.Parent = SliderBG 
    Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0) 
    local Circle = Instance.new("Frame") 
    Circle.Size = UDim2.new(0, 14, 0, 14) 
    Circle.Position = UDim2.new(1, -7, 0.5, -7) 
    Circle.BackgroundColor3 = Theme.Circle
    Circle.Parent = SliderFill 
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0) 
    
    local circleGlow = Instance.new("UIStroke")
    circleGlow.Color = Theme.Accent
    circleGlow.Thickness = 2
    circleGlow.Transparency = 0.5
    circleGlow.Parent = Circle
    
    if callback then
        task.spawn(function() callback(currentVal) end)
    end
    local dragging = false 
    local function updateSlider(input) 
        local relativeX = math.clamp(input.Position.X - SliderBG.AbsolutePosition.X, 0, SliderBG.AbsoluteSize.X) 
        local scale = relativeX / SliderBG.AbsoluteSize.X 
        SliderFill.Size = UDim2.new(scale, 0, 1, 0) 
        local value = math.floor(min + ((max - min) * scale)) 
        Label.Text = name .. ": " .. tostring(value) 
        optionStates[name] = value 
        setOptionState(name, value) 
        if callback then
            callback(value)
        end
    end
    SliderBG.MouseButton1Down:Connect(function() 
        dragging = true 
        updateSlider(Mouse)
    end)
    Mouse.Move:Connect(function() 
        if dragging then
            updateSlider(Mouse)
        end
    end)
    UserInputService.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    table.insert(options[tab], Container)
end

