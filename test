function showTab(tabName) 
    activeTab = tabName 
    for t, list in pairs(options) do
        for _, v in pairs(list) do
            v.Visible = (t == tabName)
        end
    end
    DropdownFrame.Visible = false 
    IndexMutContainer.Visible = false 
    SpecificListContainer.Visible = false 
    SellListContainer.Visible = false 
    autoSecretConfigVisible = false 
    autoSecretConfigContainer.Visible = false 
    
    for _, btn in ipairs(tabButtons) do
        local isActive = (btn == (tabName == "Main" and TabMain or tabName == "Buy" and TabBuy or tabName == "Farm" and TabFarm or tabName == "Config" and TabConfig or TabCredits))
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = isActive and Theme.AccentDim or Theme.Panel2,
            TextColor3 = isActive and Theme.Accent or Theme.Muted
        }):Play()
        local stroke = btn:FindFirstChildOfClass("UIStroke")
        if stroke then
            TweenService:Create(stroke, TweenInfo.new(0.2), {
                Color = isActive and Theme.Accent or Theme.StrokeDim,
                Transparency = isActive and 0.2 or 0.5
            }):Play()
        end
    end
    
    repositionElements(tabName)
end

