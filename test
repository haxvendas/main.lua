local inputDebounce = {} 

local function createDebounce(key, duration) 
    if inputDebounce[key] then
        return false
    end
    inputDebounce[key] = true 
    local adjustedDuration = duration or 0.05 
    task.delay(adjustedDuration, function() 
        inputDebounce[key] = nil
    end)
    return true
end

