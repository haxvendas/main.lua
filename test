            local frame = ui and ui:FindFirstChild("Frame")
            local rarityLbl = frame and frame:FindFirstChild("Rarity")
            local titleLbl = frame and frame:FindFirstChild("Title")
            local typeLbl = frame and frame:FindFirstChild("Type")
            local head = model:FindFirstChild("Head")

            if head and frame then
                local rText = rarityLbl and string.lower(rarityLbl.Text) or ""
                local tText = titleLbl and titleLbl.Text or ""
                local typeText = typeLbl and typeLbl.Text or ""
                local shouldAdd = false

                local curMut = "Normal"
                if typeText:find("Gold") then curMut = "Gold"
                elseif typeText:find("Diamond") then curMut = "Diamond"
                elseif typeText:find("Rainbow") then curMut = "Rainbow"
                elseif typeText:find("Lava") then curMut = "Lava" end

                if aSp and specificTargets[tText] and specificTargets[tText].Active and specificTargets[tText].Muts[curMut] then
                    shouldAdd = true
                elseif aSt and (rText:find("stellar") or stellarNames[tText]) then
                    shouldAdd = true
                elseif aS and (rText:find("secret") or secretNames[tText]) then
                    if tText == "Lucky Block" and not optionStates["AutoSecretLuckyBlocks"] then
                        shouldAdd = false
                    else
                        shouldAdd = true
                    end
                elseif aM and (rText:find("mythic") or mythicNames[tText]) then
                    shouldAdd = true
                elseif aL and (rText:find("legendary") or legendaryNames[tText]) then
                    shouldAdd = true
                elseif aE and (rText:find("epic") or epicNames[tText]) then
                    shouldAdd = true
                elseif rA and rebirthTargets[currentRebirthSelect] and rebirthTargets[currentRebirthSelect][tText] then
                    shouldAdd = true
                elseif aI and mutSelected[curMut] and tText ~= "Lucky Block" and not checkIndex(tText, curMut) then
                    shouldAdd = true
                end

                if shouldAdd then table.insert(allValidHeads, head) end
            end
        end
    end

    if #allValidHeads > 0 then
        if smart then
            if currentTargetIndex > #allValidHeads then currentTargetIndex = 1 end
            targetHead = allValidHeads[currentTargetIndex]
            currentTargetIndex = currentTargetIndex + 1
        else
            targetHead = allValidHeads[1]
        end
        if targetHead and targetHead.Parent then
            root.CFrame = targetHead.CFrame
            if not isHidden then setVisibility(false) end
        end
    else
        targetHead = nil
        if isHidden then setVisibility(true) end
    end
end)

