    switchBg.Position = UDim2.new(1, -50, 0.5, -10)
    switchBg.BackgroundColor3 = active and T.On or T.Off
    switchBg.Text = ""
    switchBg.AutoButtonColor = false
    switchBg.Parent = container
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = active and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = T.Circle
    circle.Parent = switchBg
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local function toggle()
        if debounce(name, 0.08) then
            optionStates[name] = not optionStates[name]
            setOptionState(name, optionStates[name])

            TweenService:Create(circle, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                Position = optionStates[name] and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            }):Play()
            TweenService:Create(switchBg, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                BackgroundColor3 = optionStates[name] and T.On or T.Off
            }):Play()

            -- glow stroke on active
            TweenService:Create(cs, TweenInfo.new(0.2), {
                Color = optionStates[name] and T.Accent or T.StrokeDim,
                Transparency = optionStates[name] and 0.3 or 0.4
            }):Play()

            if callback then
                task.wait(0.05)
                task.spawn(function() callback(optionStates[name]) end)
            end
        end
    end

    switchBg.Activated:Connect(toggle)
    switchBg.MouseButton1Click:Connect(toggle)

    if active and callback then
        task.spawn(function() callback(active) end)
    end

    -- initial stroke
    if active then
        cs.Color = T.Accent
        cs.Transparency = 0.3
    end

    table.insert(options[tab], container)
    return function() return optionStates[name] end, container, switchBg
end

local function createSlider(name, min, max, default, tab, callback)
    createOptionState(name, default)
    local val = optionStates[name]

    local container = Instance.new("Frame")
    container.Size = UDim2.new(0.97, 0, 0, 48)
    container.BackgroundColor3 = T.Card
    container.Visible = (tab == activeTab)
    container.Parent = MainContent
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 7)
    local cs = Instance.new("UIStroke", container)
    cs.Color = T.StrokeDim; cs.Thickness = 1; cs.Transparency = 0.4

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.9, 0, 0.45, 0)
    label.Position = UDim2.new(0.04, 0, 0, 3)
    label.Text = name .. ": " .. tostring(val)
    label.TextColor3 = T.Text
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = T.FontMed
    label.TextSize = 12
    label.Parent = container

    local sliderBg = Instance.new("TextButton")
    sliderBg.Size = UDim2.new(0.88, 0, 0, 5)
    sliderBg.Position = UDim2.new(0.06, 0, 0.7, 0)
    sliderBg.BackgroundColor3 = T.Off
    sliderBg.Text = ""
    sliderBg.AutoButtonColor = false
    sliderBg.Parent = container
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    local scale = (val - min) / (max - min)
    fill.Size = UDim2.new(scale, 0, 1, 0)
    fill.BackgroundColor3 = T.Accent
    fill.Parent = sliderBg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(1, -6, 0.5, -6)
    knob.BackgroundColor3 = T.Circle
    knob.Parent = fill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    -- glow on knob
    local knobGlow = Instance.new("UIStroke", knob)
    knobGlow.Color = T.Accent
    knobGlow.Thickness = 2
    knobGlow.Transparency = 0.5

    if callback then task.spawn(function() callback(val) end) end

    local dragging = false

    local function update(input)
        local rx = math.clamp(input.Position.X - sliderBg.AbsolutePosition.X, 0, sliderBg.AbsoluteSize.X)
        local s = rx / sliderBg.AbsoluteSize.X
        fill.Size = UDim2.new(s, 0, 1, 0)
        local v = math.floor(min + ((max - min) * s))
        label.Text = name .. ": " .. tostring(v)
        optionStates[name] = v
        setOptionState(name, v)
        if callback then callback(v) end
    end

    sliderBg.MouseButton1Down:Connect(function() dragging = true; update(Mouse) end)
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(input)
        end
    end)

    Mouse.Move:Connect(function() if dragging then update(Mouse) end end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            update(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    table.insert(options[tab], container)
end

