local hubOpen = false

local function openHub()
    if hubOpen then return end
    hubOpen = true
    MainFrame.Visible = true
    mfScale.Scale = 0.92
    MainFrame.BackgroundTransparency = 0.3

    TweenService:Create(mfScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1
    }):Play()
    TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 0
    }):Play()
    TweenService:Create(blurEffect, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
        Size = 12
    }):Play()
end

local function closeHub()
    if not hubOpen then return end
    hubOpen = false

    TweenService:Create(mfScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Scale = 0.92
    }):Play()
    TweenService:Create(MainFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 0.5
    }):Play()
    TweenService:Create(blurEffect, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Size = 0
    }):Play()

    task.delay(0.16, function()
        if not hubOpen then MainFrame.Visible = false end
    end)
end

local function toggleHub()
    if hubOpen then closeHub() else openHub() end
end

