    local s = Instance.new("UIStroke", btn)
    s.Color = T.StrokeDim
    s.Thickness = 1
    s.Transparency = 0.5
    s.Name = "TabStroke"

    tabButtons[name] = btn
    return btn
end

for _, name in ipairs(tabNames) do
    createTabBtn(name)
end

local function repositionElements(tab)
    local yPos = 0
    for _, elem in ipairs(options[tab]) do
        if elem.Visible then
            elem.Position = UDim2.new(0, 5, 0, yPos)
            yPos = yPos + elem.Size.Y.Offset + 6
        end
    end
    MainContent.CanvasSize = UDim2.new(0, 0, 0, yPos + 30)
end

local function showTab(tabName)
    activeTab = tabName
    for t, list in pairs(options) do
        for _, v in pairs(list) do
            v.Visible = (t == tabName)
        end
    end

    for name, btn in pairs(tabButtons) do
        if name == tabName then
            btn.BackgroundColor3 = T.AccentDim
            btn.TextColor3 = T.Accent
            local s = btn:FindFirstChild("TabStroke")
            if s then s.Color = T.Accent; s.Transparency = 0.2 end
        else
            btn.BackgroundColor3 = T.Panel2
            btn.TextColor3 = T.Muted
            local s = btn:FindFirstChild("TabStroke")
            if s then s.Color = T.StrokeDim; s.Transparency = 0.5 end
        end
    end

    repositionElements(tabName)
end

for name, btn in pairs(tabButtons) do
    btn.Activated:Connect(function() showTab(name) end)
    btn.MouseButton1Click:Connect(function() showTab(name) end)
end

