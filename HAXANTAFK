local vipPos2 = {
    Vector3.new(448.55, 172.06, 335.86),
    Vector3.new(336.28, 71.33, 138.29),
    Vector3.new(4105.28, 67.33, 136.97),
    Vector3.new(336.28, 71.33, 138.29)
}
local vipNames2 = { "SEC 1", "2", "3", "4" }

local curIndex2 = 0
local isTweening2 = false
local isAutoLooping = false 
local lastInputTime2 = 0
local DEBOUNCE2 = 0.05
local activeTween2 = nil
local statusLabel2 = nil 

-- =============================================
-- FUNÇÕES DE LÓGICA DO TP
-- =============================================

local function updateStatus2()
    if not statusLabel2 then return end
    local loopStatus = isAutoLooping and "<font color='rgb(100,255,100)'> [AUTO ATIVO]</font>" or "<font color='rgb(255,100,100)'> [MANUAL]</font>"
    
    statusLabel2.Text = "Q → Alternar Auto | R → Próximo\n" ..
                        "Status: " .. loopStatus .. "\n" ..
                        "<font color='rgb(220,200,255)'>Zona " .. (curIndex2 == 0 and "-" or curIndex2) .. "/" .. #vipPos2 ..
                        " - " .. (vipNames2[curIndex2] or "Aguardando") .. "</font>"
end

local function smoothFastTP2(targetIndex)
    if tick() - lastInputTime2 < DEBOUNCE2 then return end
    
    if activeTween2 then 
        activeTween2:Cancel() 
    end

    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    isTweening2 = true
    lastInputTime2 = tick()
    curIndex2 = targetIndex 
    updateStatus2()

    local targetPos = vipPos2[targetIndex] + Vector3.new(0, 4, 0)
    local distance = (hrp.Position - targetPos).Magnitude
    local speed = 1500
    local tweenTime = distance / speed

    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
    activeTween2 = TS:Create(hrp, tweenInfo, {
        CFrame = CFrame.new(targetPos) * CFrame.Angles(0, math.rad(180), 0)
    })

    activeTween2:Play()

    activeTween2.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed then
            isTweening2 = false
            updateStatus2()
        end
    end)
end

-- Função que executa o Loop
local function startAutoLoop()

    while isAutoLooping do

        local nextIndex = (curIndex2 % #vipPos2) + 1
        smoothFastTP2(nextIndex)

        if activeTween2 then
            activeTween2.Completed:Wait()
        end

        -- tempo diferente para SEC 1
        if nextIndex == 1 then
            task.wait(0.2)
        else
            task.wait(0.01)
        end

    end

    updateStatus2()

end
