function applyGodMode()
    if not scriptFullyLoaded then return end
    
    local char = waitForCharacter()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    -- limpa conexões antigas
    for _, conn in ipairs(godConns) do 
        pcall(function() conn:Disconnect() end)
    end
    godConns = {}
    
    hum.MaxHealth = math.huge
    hum.Health = math.huge
    hum.JumpPower = 50
    
    table.insert(godConns, hum.HealthChanged:Connect(function()
        if hum and hum.Parent then
            hum.Health = math.huge
        end
    end))
    
    table.insert(godConns, hum.Died:Connect(function()
        -- não tenta mexer no humanoid morto
        -- deixa o CharacterAdded cuidar disso
    end))
    
    table.insert(godConns, RunService.Heartbeat:Connect(function()
        if not hum or not hum.Parent then return end
        
        local s = hum:GetState()
        if s == Enum.HumanoidStateType.Ragdoll 
        or s == Enum.HumanoidStateType.Physics 
        or s == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
        end
        
        for _, v in ipairs(hum:GetChildren()) do
            if (v:IsA("BoolValue") or v:IsA("NumberValue")) then
                local name = v.Name:lower()
                if name:find("stun") or name:find("slow") 
                or name:find("poison") or name:find("bleed") 
                or name:find("knock") then
                    v:Destroy()
                end
            end
        end
    end))
end

