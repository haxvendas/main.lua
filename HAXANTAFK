-- Hitbox Expander (Toggle H)
-- =============================================
local hitboxExpanded = false
local originalSizes = {}
local NOVO_TAMANHO = Vector3.new(40,40,40)
local HITBOX_TRANSPARENCY = 0.7

local function expandHitboxes()
    local backpack = plr:WaitForChild("Backpack")
    local character = plr.Character
    local count = 0

    if not hitboxExpanded then
        originalSizes = {}
    end

    local function processTool(tool)
        if tool:IsA("Tool") then
            local hitbox = tool:FindFirstChild("Hitbox", true)
            if hitbox and hitbox:IsA("BasePart") then
                if not originalSizes[tool] then
                    originalSizes[tool] = hitbox.Size
                end
                hitbox.Size = NOVO_TAMANHO
                hitbox.Transparency = HITBOX_TRANSPARENCY
                hitbox.CanCollide = false
                count += 1
            end
        end
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        processTool(tool)
    end

    if character then
        for _, tool in ipairs(character:GetChildren()) do
            processTool(tool)
        end
    end

    return count
end

local function restoreHitboxes()
    local count = 0

    for tool, size in pairs(originalSizes) do
        if tool and tool.Parent then
            local hitbox = tool:FindFirstChild("Hitbox", true)
            if hitbox and hitbox:IsA("BasePart") then
                hitbox.Size = size
                hitbox.Transparency = 0
                count += 1
            end
        end
    end

    originalSizes = {}
    return count
end

local function toggleHitboxExpander()
    hitboxExpanded = not hitboxExpanded

    if hitboxExpanded then
        local count = expandHitboxes()
        print("Hitbox ON:", count)
    else
        restoreHitboxes()
        print("Hitbox OFF")
    end
end

