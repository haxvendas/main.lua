-- VFLY ALTERNATIVO (LinearVelocity + AlignOrientation) - TECLA V
-- Mais difícil de detectar que BodyVelocity + BodyGyro
-- =============================================

local vflyEnabled = true -- começa desligado (mude para true se quiser auto-ativar)
local flyConnection = nil
local lv = nil             -- LinearVelocity
local ao = nil             -- AlignOrientation

local keys = { W = false, A = false, S = false, D = false, Space = false }

-- Captura de teclas (mantém compatível com o resto do script)
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then keys.W = true end
    if input.KeyCode == Enum.KeyCode.A then keys.A = true end
    if input.KeyCode == Enum.KeyCode.S then keys.S = true end
    if input.KeyCode == Enum.KeyCode.D then keys.D = true end
    if input.KeyCode == Enum.KeyCode.Space then keys.Space = true end

    -- Toggle com tecla V
    if input.KeyCode == Enum.KeyCode.V then
        vflyEnabled = not vflyEnabled
        if vflyEnabled then
            startVFly()
        else
            stopVFly()
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then keys.W = false end
    if input.KeyCode == Enum.KeyCode.A then keys.A = false end
    if input.KeyCode == Enum.KeyCode.S then keys.S = false end
    if input.KeyCode == Enum.KeyCode.D then keys.D = false end
    if input.KeyCode == Enum.KeyCode.Space then keys.Space = false end
end)

stopVFly = function()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    if lv then lv:Destroy() lv = nil end
    if ao then ao:Destroy() ao = nil end
    
    -- Restaura física normal
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

startVFly = function()
    stopVFly()

    local char = plr.Character
    if not char then return end

    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true  -- desativa gravidade do humanoid

    -- LinearVelocity (substituto moderno do BodyVelocity)
    lv = Instance.new("LinearVelocity")
    lv.Name = "VFly_LV"
    lv.Attachment0 = Instance.new("Attachment", hrp)
    lv.MaxForce = 50000          -- valor mais baixo = menos suspeito
    lv.VectorVelocity = Vector3.zero
    lv.Parent = hrp

    -- AlignOrientation (substituto do BodyGyro)
    ao = Instance.new("AlignOrientation")
    ao.Name = "VFly_AO"
    ao.Attachment0 = Instance.new("Attachment", hrp)
    ao.MaxTorque = 50000
    ao.Responsiveness = 50       -- suavidade
    ao.Parent = hrp

    flyConnection = RunService.RenderStepped:Connect(function()
        if not vflyEnabled or not hrp.Parent then 
            stopVFly()
            return 
        end

        local cam = workspace.CurrentCamera
        local dir = Vector3.zero

        if keys.W then dir += cam.CFrame.LookVector end
        if keys.S then dir -= cam.CFrame.LookVector end
        if keys.A then dir -= cam.CFrame.RightVector end
        if keys.D then dir += cam.CFrame.RightVector end
        if keys.Space then dir += Vector3.new(0, 1, 0) end

        -- Normaliza e aplica velocidade (ajuste o 120 se quiser mais rápido/lento)
        if dir.Magnitude > 0 then
            dir = dir.Unit * 600
        end

        lv.VectorVelocity = dir
        ao.CFrame = cam.CFrame  -- olha para onde a câmera aponta
    end)
end

