local function setupAutoDeposit()
    local function activatePrompt(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") then return end
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 30
        
        task.spawn(function()
            while prompt and prompt.Parent and prompt.Enabled do
                pcall(fireproximityprompt, prompt)
                task.wait(0.18)
            end
        end)
    end

    local function scanForCannon()
        local pMap = workspace:FindFirstChild("PhantomMap")
        if not pMap then return end
        
        local cannon = pMap:FindFirstChild("GhostCannon")
        if not cannon then return end
        
        local part = cannon:FindFirstChild("Part")
        if not part then return end
        
        local prompts = part:FindFirstChild("Prompts")
        if not prompts then return end
        
        for _, prompt in prompts:GetChildren() do
            activatePrompt(prompt)
        end
    end

    -- Primeira tentativa
    task.wait(1.5)
    scanForCannon()

    -- Monitora novos PhantomMap
    workspace.ChildAdded:Connect(function(child)
        if child.Name == "PhantomMap" then
            task.wait(1.2)
            scanForCannon()
        end
    end)
    
    -- Monitora já existentes (caso recarregue rápido)
    for _, map in workspace:GetChildren() do
        if map.Name == "PhantomMap" then
            task.spawn(scanForCannon)
        end
    end
end

