local RARE_NAMES = {
    "chicleteira bicicleteira",
    "ta ta ta ta sahur",
    "tung tung tung sahur",
    "dragon cannelloni",
    "tim cheese",
    "strawberry elephant",
    "evil six seven",
    "Meowl"
}
local debounce = false
local coletados = {}

local function isRare(name)
    local lower = name:lower()
    for _, r in ipairs(RARE_NAMES) do
        if lower:find(r) then
            return true, r
        end
    end
    return false
end

