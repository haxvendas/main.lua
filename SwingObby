-- 🔥 PEGAR TEMPO FLEX
local function extractTime(txt)
    return txt:match("IN:%s*(.+)") or "..."
end

local function getEvents()
    local eventos = {
        void = "...",
        divine = "...",
        godly = "..."
    }

    local eventSign = workspace:FindFirstChild("EventSign")
    if not eventSign then return eventos end

    local folder = eventSign:GetChildren()[7]
    if not folder then return eventos end

    local gui = folder:FindFirstChild("SurfaceGui")
    if not gui then return eventos end

    -- VOID
    local void = gui:FindFirstChild("Void")
    if void and void:FindFirstChild("TextLabel") then
        eventos.void = extractTime(void.TextLabel.Text)
    end

    -- DIVINE
    local divine = gui:FindFirstChild("Divine")
    if divine and divine:FindFirstChild("TextLabel") then
        eventos.divine = extractTime(divine.TextLabel.Text)
    end

    -- GODLY
    local godly = gui:FindFirstChild("Godly")
    if godly and godly:FindFirstChild("TextLabel") then
        eventos.godly = extractTime(godly.TextLabel.Text)
    end

    return eventos
end

